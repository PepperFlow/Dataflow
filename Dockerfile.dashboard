FROM python:3.11-slim

WORKDIR /app

# Installera dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopiera dashboard
COPY dashboard.py .

EXPOSE 8501

# Starta Streamlit
CMD ["streamlit", "run", "dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
